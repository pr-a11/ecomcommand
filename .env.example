# EcomCommand — environment variable template.
# Copy to `.env.local` (local dev) or paste into Vercel → Project → Settings →
# Environment Variables. Every value below is a placeholder; fill in real keys.

# ---------------------------------------------------------------------------
# Client-exposed (NEXT_PUBLIC_*) — inlined into the browser bundle at build
# time. NEVER put a secret / service-role key behind a NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# REQUIRED. Supabase project REST URL used by the browser and SSR clients.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# REQUIRED. Supabase anon/publishable key (safe to expose; RLS enforces access).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional. Canonical public origin, e.g. used for auth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:4028

# Optional. Google Analytics 4 measurement id.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional. Google AdSense publisher id.
NEXT_PUBLIC_ADSENSE_ID=ca-pub-0000000000000000

# Optional. Stripe publishable key (public by design; never the secret key).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ---------------------------------------------------------------------------
# Server-only — never prefixed with NEXT_PUBLIC_, never sent to the browser.
# ---------------------------------------------------------------------------

# Optional. Overrides the Next.js build output directory (default `.next`).
DIST_DIR=.next

# Optional. OpenAI API key for the Ask-AI assistant.
OPENAI_API_KEY=sk-your-openai-api-key

# Optional. Anthropic API key for the Ask-AI assistant.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Optional. Perplexity API key for the Ask-AI assistant.
PERPLEXITY_API_KEY=pplx-your-perplexity-api-key

# Optional. OpenRouter API key for the Ask-AI assistant.
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
